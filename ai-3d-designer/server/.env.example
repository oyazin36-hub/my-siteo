# このファイルを .env にコピーして使う。.env は git にコミットしないこと。
#
# 既定値のままで、Firebase も OpenAI キーも無しに動きます(すべて開発モード)。

# local | staging | production
APP_ENVIRONMENT=local

# --- 認証 ---
# firebase      … Firebase の ID トークンを検証する(本番はこちら)
# insecure_dev  … トークンを検証せず uid として扱う。Firebase 未作成でも開発を始められる。
APP_AUTH_MODE=insecure_dev

# APP_AUTH_MODE=firebase のときに使う
# APP_FIREBASE_PROJECT_ID=your-project-id
# サービスアカウント JSON のパス。Cloud Run 上では未設定でよい(ADC を使う)。
# APP_FIREBASE_CREDENTIALS_PATH=./serviceAccount.json

# --- AI (STEP2 企画生成 / STEP3 画像生成) ---
# openai … 実際に OpenAI を呼ぶ。APP_OPENAI_API_KEY が必須。
# stub   … 呼ばずに固定の企画と単色画像を返す。キー無しで流れを確認するためのもの。
APP_AI_MODE=stub

# APP_AI_MODE=openai のときに必須
# APP_OPENAI_API_KEY=sk-...
# APP_OPENAI_LLM_MODEL=gpt-4o-2024-08-06
# APP_OPENAI_IMAGE_MODEL=gpt-image-1

# --- 保存先 ---
# memory    … プロセス終了で消える。ローカル開発用。
# firestore … Firestore に保存する(本番)。
APP_REPOSITORY_MODE=memory

# local … ローカルのファイルに保存し /media で配信する。ローカル開発用。
# cloud … Firebase Cloud Storage に保存する(本番)。
APP_STORAGE_MODE=local
APP_LOCAL_MEDIA_ROOT=./var/media
# APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# JSON 配列で指定する。Flutter Web から叩く場合などに設定する。
# APP_CORS_ORIGINS=["http://localhost:8080"]

# --- 安全装置 ---
# insecure_dev と stub は APP_ENVIRONMENT=local 以外では起動時にエラーになります。
# 本番に紛れ込むことはありません。
